#pragma kernel HeightMapCompute

Texture2D<float4> currentHeightMap; 
RWTexture2D<float4> accumulatedHeightMap; 

[numthreads(8, 8, 1)]
void HeightMapCompute(uint3 id : SV_DispatchThreadID)
{
 
    float currentHeight = currentHeightMap[id.xy].r;


    float accumulatedHeight = accumulatedHeightMap[id.xy].r;


    accumulatedHeightMap[id.xy] = float4(currentHeight + accumulatedHeight, 0, 0, 0);
}